# Maintainer: rpredatorsense contributors
# Acer Predator Helios 16 (PH16-71) control: fans, power, battery, GPU mode, lighting, Fn keys, audio helpers.
# Build from a checkout:  cd packaging/arch && makepkg -si
pkgname=rpredatorsense
pkgver=0.1.0
pkgrel=1
pkgdesc='PredatorSense for Linux: Acer Predator Helios 16 PH16-71 (fans, power modes, battery, lighting, Fn keys, Purified Voice)'
arch=('x86_64')
url='https://github.com/'
license=('GPL-2.0-only')
depends=('python' 'dkms' 'linux-headers' 'systemd')
optdepends=('noise-suppression-for-voice: Purified Voice (RNNoise) microphone/speaker noise reduction'
            'alsa-tools: codec diagnostics (hda-verb)'
            'msr-tools: undervolt/RAPL diagnostics'
            'nvidia-utils: GPU temperature and power limit'
            'openrgb: alternative lighting tools')
backup=('etc/rpredatorsense/config.toml')
options=('!strip')
_src="$startdir/../.."

package() {
    install -d "$pkgdir/usr/lib/rpredatorsense"
    cp -r "$_src/src/rpredatorsense" "$pkgdir/usr/lib/rpredatorsense/"
    find "$pkgdir/usr/lib/rpredatorsense" -name __pycache__ -prune -exec rm -rf {} +
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/rpredatorsense" <<'WRAP'
#!/bin/sh
exec env PYTHONPATH=/usr/lib/rpredatorsense python3 -m rpredatorsense "$@"
WRAP
    install -Dm755 "$_src/packaging/health.sh" "$pkgdir/usr/lib/rpredatorsense/health.sh"
    # services (system daemon + health timer, user key service)
    for f in rpredatorsense.service rpredatorsense-health.service rpredatorsense-health.timer; do
        sed -e 's|/usr/local/bin/|/usr/bin/|g' -e 's|/usr/local/lib/|/usr/lib/|g' "$_src/packaging/$f" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/$f"
    done
    sed 's|/usr/local/bin/|/usr/bin/|g' "$_src/packaging/rpredatorsense-keys.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/rpredatorsense-keys.service"
    sed 's|/usr/local/bin/|/usr/bin/|g' "$_src/packaging/rpredatorsense-audio.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/rpredatorsense-audio.service"
    install -Dm644 "$_src/packaging/70-rpredatorsense.rules" "$pkgdir/usr/lib/udev/rules.d/70-rpredatorsense.rules"
    # kernel helper (WMI whitelist interface) as DKMS source
    install -d "$pkgdir/usr/src/acer-rear-wmi-1.2"
    install -m644 "$_src"/kernel/acer-rear-wmi/{acer_rear_wmi.c,Makefile,dkms.conf} "$pkgdir/usr/src/acer-rear-wmi-1.2/"
    install -Dm644 /dev/stdin "$pkgdir/etc/rpredatorsense/config.toml" <<'CFG'
# overrides for the built-in defaults (see /usr/lib/rpredatorsense/rpredatorsense/config.py)
user = "CHANGE_ME"
CFG
    install -Dm644 "$_src/docs/STATUS.md" "$pkgdir/usr/share/doc/rpredatorsense/STATUS.md"
}
